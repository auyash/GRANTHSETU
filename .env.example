# =====================================================================
# GRANTHSETU — Environment Configuration Template
# =====================================================================
# Copy this file to .env and configure values for your environment.
# DO NOT commit .env or real credentials to version control.
# =====================================================================

# Operation Mode:
# 'mock' -> Safe standalone offline simulation (Default for demos/cloud evaluation)
# 'live' -> Connects to official Koha 26 SIP2 server over TCP socket
KOHA_MODE=mock

# Koha 26 SIP2 Connection Parameters (Required if KOHA_MODE=live)
# Replace with the IP/hostname of your authorized Koha test/staging server
KOHA_SERVER_IP=192.168.1.100
KOHA_SERVER_PORT=6001
KOHA_USER=your_test_sip2_username
KOHA_PASS=your_test_sip2_password
KOHA_LOCATION=NFSU
# Optional Terminal Password (leave blank if not configured in SIPconfig.xml)
KOHA_TERMINAL_PASSWORD=

# SIP2 Protocol Advanced Configuration
# SIP2_ENCODING: Character encoding for SIP2 stream (default: utf-8). Must match Koha SIPconfig.xml encoding.
SIP2_ENCODING=utf-8
# SIP2_CHECK_SEQUENCE: Whether to strictly validate AY sequence numbers (default: false, matching Koha sequence=no default).
SIP2_CHECK_SEQUENCE=false
# SIP2_SOCKET_TIMEOUT: Socket read/write timeout in seconds (default: 4.0)
SIP2_SOCKET_TIMEOUT=4.0

# Session Inactivity Timeout (Seconds)
# Server-side inactivity expiry limit (default: 60 seconds; client idle timer is 30s)
SESSION_TIMEOUT_SECONDS=60

# Local Web Server Configuration
HOST=127.0.0.1
PORT=8050

# Hardware Abstraction Layer (HAL) Configuration
# HARDWARE_MODE: 'SIMULATED' (default) or 'PHYSICAL'
HARDWARE_MODE=SIMULATED
# Barcode Scanner: 'SIMULATED', 'USB_HID' (standard keyboard-wedge), or 'SERIAL'
BARCODE_SCANNER_MODE=SIMULATED
# BARCODE_SCANNER_PORT=COM1
# Smart Card Reader: 'SIMULATED', 'PCSC' (standard PC/SC USB), or 'SERIAL'
SMART_CARD_MODE=SIMULATED
# SMART_CARD_PORT=COM2
# RFID Antenna & Exit Gate: 'SIMULATED', 'FEIG_USB', 'NORDIC_ID', or 'SERIAL'
RFID_READER_MODE=SIMULATED
# RFID_READER_PORT=COM3


